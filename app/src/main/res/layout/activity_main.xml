<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1A1A2E">

    <!-- 顶栏图标 -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:gravity="center"
        android:background="@drawable/circle_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="40dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seedum 授权绕过"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telegram Bot Authorization Bypass"
        android:textSize="13sp"
        android:textColor="#8888AA"
        android:layout_marginTop="4dp" />

    <!-- 状态卡片 -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="20dp"
        android:layout_marginTop="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="绕过状态"
            android:textSize="14sp"
            android:textColor="#8888AA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/statusIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/green_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ 已激活 · 已绕过"
                android:textSize="18sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginLeft="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模块已安装，LSPosed 中勾选后重启作用域即可生效"
            android:textSize="12sp"
            android:textColor="#666688"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- 功能介绍卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="20dp"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="绕过策略"
            android:textSize="14sp"
            android:textColor="#8888AA" />

        <TextView
            android:id="@+id/hookInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ 检测中..."
            android:textSize="15sp"
            android:textColor="#CCCCDD"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- 底部按钮 -->
    <Button
        android:id="@+id/checkBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="检查绕过状态"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_bg"
        android:textAllCaps="false"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 | 仅在 Seedum 进程生效"
        android:textSize="11sp"
        android:textColor="#555577"
        android:layout_marginTop="20dp" />

</LinearLayout>
